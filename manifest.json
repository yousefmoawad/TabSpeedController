{
  "manifest_version": 3,
  "name": "Tab Speed Controller",
  "version": "1.1.0",
  "description": "Simulate network conditions for the current Chrome tab.",
  "permissions": ["debugger", "tabs", "activeTab", "storage"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Tab Speed Controller"
  },
  "background": {"service_worker": "background.js"}
}
